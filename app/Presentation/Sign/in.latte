{block content}
<div class="section-container">
    <div class="content-wrapper">
        <div class="card-premium mx-auto" style="max-width: 400px;">
            <h2 class="text-primary mb-4">Přihlášení</h2>
            <form n:name=signInForm class="form">
                <div n:foreach="$form->errors as $error" class="alert alert-danger">{$error}</div>
                
                <div class="form-group mb-3">
                    <label n:name=username class="form-label">Uživatelské jméno</label>
                    <input n:name=username class="form-control">
                </div>

                <div class="form-group mb-3">
                    <label n:name=password class="form-label">Heslo</label>
                    <input n:name=password class="form-control">
                </div>

                <button n:name=send class="btn-primary-custom w-100">Přihlásit se</button>
            </form>
        </div>
    </div>
</div>
{/block}
