<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{ifset title}{include title|stripHtml} | {/ifset}ASK Hořovice</title>
	
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
	<link rel="stylesheet" href="{$basePath}/css/premium-design.css">
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	
	{block head}{/block}
</head>
<body>

	<nav class="navbar navbar-expand-lg">
		<div class="container-fluid">
			<a class="navbar-brand" n:href="Home:default">
				<img src="{$basePath}/SVGLOGA/sadasdsd.svg" alt="ASK Hořovice" style="height: 50px;">
				<span>ASK Hořovice</span>
			</a>

			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav ms-auto align-items-center" style="gap: 0.5rem;">
					<li class="nav-item"><a class="nav-link" n:href="Home:default#home">Domů</a></li>
					<li class="nav-item"><a class="nav-link" n:href="Home:default#zavody">Závody</a></li>
					<li class="nav-item"><a class="nav-link" n:href="Home:default#about">O nás</a></li>
					<li class="nav-item"><a class="nav-link" n:href="Home:default#galerie">Galerie</a></li>
					<li class="nav-item"><a class="nav-link" n:href="Home:default#kontakt">Kontakt</a></li>
					
					{if $user->isLoggedIn()}
						<li class="nav-item"><a class="nav-link" n:href="Organizer:default">Pro pořadatele</a></li>
						{if $user->isInRole('admin')}
							<li class="nav-item"><a class="nav-link" n:href="Admin:logs">Logy</a></li>
						{/if}
						<li class="nav-item" style="margin-left: 1rem;">
							<a n:href="Sign:out" class="btn-secondary-custom" style="display: inline-block;">Odhlásit se</a>
						</li>
					{else}
						<li class="nav-item" style="margin-left: 1rem;">
							<a n:href="Sign:in" class="btn-secondary-custom" style="display: inline-block;">Přihlášení</a>
						</li>
					{/if}
				</ul>
			</div>
		</div>
	</nav>

	<div n:foreach="$flashes as $flash" n:class="alert, 'alert-' . $flash->type, mt-2">{$flash->message}</div>

	{include content}

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	<script src="{$basePath}/js/main.js"></script>
	{block scripts}{/block}
</body>
</html>
